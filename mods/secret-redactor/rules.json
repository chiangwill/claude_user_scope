[
  {
    "name": "private-key",
    "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----",
    "flags": "g",
    "replacement": "[REDACTED:private-key]"
  },
  {
    "name": "anthropic-key",
    "pattern": "sk-ant-[A-Za-z0-9_-]{20,}",
    "flags": "g",
    "replacement": "[REDACTED:anthropic-key]"
  },
  {
    "name": "openai-key",
    "pattern": "sk-(?:proj-)?[A-Za-z0-9_-]{20,}",
    "flags": "g",
    "replacement": "[REDACTED:openai-key]"
  },
  {
    "name": "github-token",
    "pattern": "gh[pousr]_[A-Za-z0-9]{36,}",
    "flags": "g",
    "replacement": "[REDACTED:github-token]"
  },
  {
    "name": "gitlab-token",
    "pattern": "glpat-[A-Za-z0-9_-]{20,}",
    "flags": "g",
    "replacement": "[REDACTED:gitlab-token]"
  },
  {
    "name": "aws-access-key-id",
    "pattern": "\\b(?:AKIA|ASIA)[A-Z0-9]{16}\\b",
    "flags": "g",
    "replacement": "[REDACTED:aws-access-key-id]"
  },
  {
    "name": "slack-token",
    "pattern": "xox[baprs]-[A-Za-z0-9-]{10,}",
    "flags": "g",
    "replacement": "[REDACTED:slack-token]"
  },
  {
    "name": "jwt",
    "pattern": "\\beyJ[A-Za-z0-9_-]+\\.eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+",
    "flags": "g",
    "replacement": "[REDACTED:jwt]"
  },
  {
    "name": "conn-password",
    "pattern": "(\\b[a-z][a-z0-9+.-]*:\\/\\/[^\\s:\\/@]+:)(?!\\[REDACTED)([^\\s@\\/]+)(@)",
    "flags": "gi",
    "replacement": "$1[REDACTED:conn-password]$3"
  },
  {
    "name": "env-var",
    "pattern": "(\\b[A-Z0-9_]*(?:PASSWORD|PASSWD|SECRET|TOKEN|API_KEY|APIKEY|PRIVATE_KEY|ACCESS_KEY|CREDENTIAL|PASSPHRASE|SIGNING_KEY|ENCRYPTION_KEY)[A-Z0-9_]*[\"']?\\s*[=:]\\s*[\"']?)(?!\\[REDACTED)([^\\s\"'#,]+)",
    "flags": "gi",
    "replacement": "$1[REDACTED:env-var]"
  }
]
