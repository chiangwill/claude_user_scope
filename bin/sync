#!/usr/bin/env bash
# Stage, commit, and push all changes in the dotclaude repo.
# Repo location self-locates from this script, so any clone path/depth works.
# Usage: sync [commit message]
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="${REPO_DIR:-$(dirname "$script_dir")}"
cd "$repo"

if [[ -z "$(git status --porcelain)" ]]; then
  echo "Nothing to sync."
  exit 0
fi

msg="${*:-update}"
git add -A
git commit -m "$msg"
git push
echo "Pushed: $msg"
