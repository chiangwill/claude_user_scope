#!/usr/bin/env bash
# List feedback memories not yet promoted to CLAUDE.md.
# Read-only — never edits files. The /dotclaude evolve skill uses this
# output to walk the user through promotion interactively.
#
# Usage: evolve

set -euo pipefail

MEMORY_DIR="$HOME/.claude/projects/-Users-a1234/memory"
CLAUDE_MD="$HOME/.claude/CLAUDE.md"

if [[ ! -d "$MEMORY_DIR" ]]; then
  echo "No memory directory: $MEMORY_DIR"
  exit 0
fi

unpromoted=()
shopt -s nullglob
for f in "$MEMORY_DIR"/*.md; do
  [[ "$(basename "$f")" == "MEMORY.md" ]] && continue
  grep -q "type: feedback" "$f" 2>/dev/null || continue
  name=$(basename "$f" .md)
  if [[ -f "$CLAUDE_MD" ]] && grep -qF "$name" "$CLAUDE_MD" 2>/dev/null; then
    continue
  fi
  unpromoted+=("$f")
done

if [[ ${#unpromoted[@]} -eq 0 ]]; then
  echo "All feedback memories are referenced in CLAUDE.md. Nothing to promote."
  exit 0
fi

echo "=== ${#unpromoted[@]} unpromoted feedback memories ==="
echo ""
for f in "${unpromoted[@]}"; do
  echo "---FILE: $f"
  cat "$f"
  echo ""
done
